# App runtime config (src/lapp/__main__.py) - override the CLI flag defaults
LAPP_ENV=        # dev | test | prod
LAPP_HOST=       # bind address, e.g. 0.0.0.0 to accept external connections
LAPP_PORT=
LAPP_DEBUG=

# Browser-facing address (client/next.config.ts) - the host/port the BROWSER uses to reach
# the server. Never 0.0.0.0 here (browsers refuse to fetch it). Defaults to LAPP_HOST/LAPP_PORT
# if unset - only needed when those differ from what's browser-reachable, e.g. LAPP_HOST=0.0.0.0.
LAPP_PUBLIC_HOST=
LAPP_PUBLIC_PORT=

# Extra hostnames media can be served from besides LAPP_PUBLIC_HOST/PORT (client/next.config.ts),
# e.g. a reverse-proxy domain: LAPP_EXTRA_MEDIA_HOSTS=fluence.home,192.168.1.93:8080
LAPP_EXTRA_MEDIA_HOSTS=

# Postgres connection string used by the Flask app (src/config.py)
# format: postgresql://<user>:<password>@<host>:<port>/<db>
# Use 'localhost' for native/non-Docker runs. docker-compose.yml overrides the host to 'db'
# automatically for the backend container - no need to change this value for Docker.
DATABASE_URL=

# Port the Next.js client dev/start server listens on (read natively by the Next CLI).
PORT=

# Hugging Face token for downloading gated/rate-limited models (read automatically by
# huggingface_hub/transformers/sentence-transformers, no code reference needed).
HF_TOKEN=

# Force a specific torch device for model inference (src/lapp/utils/models.py), e.g. cpu | cuda | mps.
# Leave unset to auto-detect.
LAPP_DEVICE=

# Override which HF model repo each local task uses (src/lapp/utils/models.py). Leave
# commented out to use the defaults shown below - do NOT set to an empty value with a trailing
# comment, e.g. `LAPP_TEXT_EMBEDDING_MODEL=   # default: ...`: python-dotenv treats an unquoted
# empty value followed by a comment as a LITERAL value (the comment text itself), not as unset.
# Runs fully offline automatically once a repo's files are cached locally. Text/audio embedding
# and speech-to-text stay local (no external API fits them well / STT runs synchronously during
# exercise evaluation and can't depend on an external server being reachable).
# LAPP_TEXT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# LAPP_AUDIO_EMBEDDING_MODEL=facebook/mms-300m
# LAPP_STT_MODEL=openai/whisper-tiny

# Text generation, feedback, and text-to-speech each call a configurable OpenAI-compatible API
# endpoint (src/lapp/utils/model_api.py) instead of a local model - point them at a self-hosted
# server (llama.cpp server, ollama) or a third-party provider (OpenAI, Anthropic, DeepSeek,
# Kimi, ...) that exposes an OpenAI-compatible surface. There is no server-wide default: each
# user configures their own base_url/api_key/model per task from their Settings in the app -
# a task is simply skipped for a user who hasn't configured it.

# Skip startup background tasks (TTS/text-gen warmup) on boot, useful for faster local iteration.
LAPP_SKIP_STARTUP_TASKS=

# Prod-only media/backup storage paths (src/config.py ProductionConfig) - leave unset to keep
# the default ./media and ./backups directories under the repo root. Must be absolute paths.
# Also used by docker-compose.yml as the host-side bind-mount paths for the backend container.
PROD_MEDIA_ROOT=
PROD_BACKUP_ROOT=

# Docker only: restore the latest backup from PROD_BACKUP_ROOT before the backend starts
# (runs before alembic migrations). Leave unset/false for a normal boot.
RESTORE_LATEST_BACKUP=