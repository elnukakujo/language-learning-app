# Copy to k8s/secrets.yaml, fill in real values, apply manually on PCT:
#   kubectl apply -f k8s/secrets.yaml
# k8s/secrets.yaml is gitignored — CI never needs the values, only references
# this Secret by name.
apiVersion: v1
kind: Secret
metadata:
  name: fluence-secrets
  namespace: fluence
type: Opaque
stringData:
  POSTGRES_PASSWORD: "changeme"
  DATABASE_URL: "postgresql://fluence_app:changeme@postgres:5432/fluence"
  HF_TOKEN: ""
